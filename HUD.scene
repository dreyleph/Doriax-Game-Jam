id: 2184184002
name: HUD
scene:
  backgroundColor: [0, 0, 0, 0]
  lightState: off
  enableUIEvents: not_set
sceneType: scene_ui
mainCamera: 0
visibilityInherited: true
entities:
  - type: Entity
    entity: 1001
    name: HUD
    components:
      transform:
        position: [0, 0, 0]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        visible: true
      script:
        scripts:
          - type: lua
            path: ui/HUD.lua
            className: HUD
            enabled: true
            properties:
              - name: scoreText
                displayName: Texto dos pontos
                type: EntityReference
                ptrTypeName: Text
                value: 1002
                defaultValue: 0
              - name: livesText
                displayName: Texto das vidas
                type: EntityReference
                ptrTypeName: Text
                value: 1003
                defaultValue: 0
              - name: gameOverText
                displayName: Texto de game over
                type: EntityReference
                ptrTypeName: Text
                value: 1004
                defaultValue: 0
              - name: scoreDigits
                displayName: Digitos da pontuacao
                type: Int
                value: 6
                defaultValue: 6
  - type: Entity
    entity: 1002
    name: Pontos
    components:
      transform:
        position: [0, 0, 0]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        visible: true
      uilayout:
        anchorPreset: TOP_LEFT
        usingAnchors: true
        positionOffset: [32, 24]
      ui:
        color: [1, 0.85, 0.25, 1]
      text:
        text: PONTOS 000000
        fontSize: 32
  - type: Entity
    entity: 1003
    name: Vidas
    components:
      transform:
        position: [0, 0, 0]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        visible: true
      uilayout:
        anchorPreset: TOP_LEFT
        usingAnchors: true
        positionOffset: [32, 66]
      ui:
        color: [1, 1, 1, 1]
      text:
        text: VIDAS x3
        fontSize: 28
  - type: Entity
    entity: 1004
    name: GameOver
    components:
      transform:
        position: [0, 0, 0]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        visible: false
      uilayout:
        anchorPreset: CENTER
        usingAnchors: true
      ui:
        color: [0.95, 0.25, 0.2, 1]
      text:
        text: GAME OVER
        fontSize: 80
  - type: Entity
    entity: 1010
    name: MenuPausa
    components:
      transform:
        position: [0, 0, 0]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        visible: false
      uilayout:
        width: 960
        height: 720
        anchorPreset: CENTER
        usingAnchors: true
      ui:
        color: [0, 0, 0, 0.6]
      image:
        patchMarginLeft: 0
      script:
        scripts:
          - type: lua
            path: ui/PauseMenu.lua
            className: PauseMenu
            enabled: true
            properties:
              - name: continueButton
                displayName: Botao Continuar
                type: EntityReference
                ptrTypeName: Button
                value: 1011
                defaultValue: 0
              - name: menuButton
                displayName: Botao Menu
                type: EntityReference
                ptrTypeName: Button
                value: 1013
                defaultValue: 0
              - name: quitButton
                displayName: Botao Sair
                type: EntityReference
                ptrTypeName: Button
                value: 1015
                defaultValue: 0
    children:
      - type: Entity
        entity: 1005
        name: Pausado
        components:
          transform:
            position: [0, 0, 0]
            rotation: [1, 0, 0, 0]
            scale: [1, 1, 1]
            visible: true
          uilayout:
            anchorPreset: CENTER
            usingAnchors: true
            positionOffset: [0, -200]
          ui:
            color: [1, 1, 1, 1]
          text:
            text: PAUSED
            fontSize: 80
      - type: Entity
        entity: 1011
        name: BotaoContinuar
        components:
          transform:
            position: [0, 0, 0]
            rotation: [1, 0, 0, 0]
            scale: [1, 1, 1]
            visible: true
          uilayout:
            width: 260
            height: 56
            anchorPreset: CENTER
            usingAnchors: true
            positionOffset: [0, -80]
          ui:
            color: [0.25, 0.2, 0.17, 1]
          image:
            patchMarginLeft: 0
          button:
            label: 1012
            colorNormal: [0.25, 0.2, 0.17, 1]
            colorHovered: [0.91, 0.667, 0.235, 1]
            colorPressed: [0.6, 0.44, 0.15, 1]
            scaleHovered: 1.05
        children:
          - type: Entity
            entity: 1012
            name: Texto
            components:
