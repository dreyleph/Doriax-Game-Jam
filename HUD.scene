        billboardRotation: [1, 0, 0, 0]
        billboard: false
        fakeBillboard: false
        cylindricalBillboard: false
      script:
        scripts:
          - type: lua
            path: ui/HUD.lua
            className: HUD
            enabled: true
            properties:
              - name: scoreText
                displayName: Texto dos pontos
                type: EntityReference
                ptrTypeName: Text
                value: 1002
                defaultValue: 0
              - name: livesText
                displayName: Texto das vidas
                type: EntityReference
                ptrTypeName: Text
                value: 1003
                defaultValue: 0
              - name: gameOverText
                displayName: Texto de game over
                type: EntityReference
                ptrTypeName: Text
                value: 1004
                defaultValue: 0
              - name: ammoText
                displayName: Texto da municao
                type: EntityReference
                ptrTypeName: Text
                value: 1005
                defaultValue: 0
              - name: scoreDigits
                displayName: Digitos da pontuacao
                type: Int
                value: 6
                defaultValue: 6
              - name: fontPath
                displayName: Fonte do HUD (caminho em assets/)
                type: String
                value: Fonte/BoldPixels.ttf
                defaultValue: Fonte/BoldPixels.ttf
              - name: lifeIcon
                displayName: Icone de vida (caminho em assets/, vazio = texto)
                type: String
                value: HUD/vida_tipu.png
                defaultValue: HUD/vida_tipu.png
              - name: lifeIconWidth
                displayName: "Icone de vida: largura (px)"
                type: Float
                value: 22
                defaultValue: 22
              - name: lifeIconHeight
                displayName: "Icone de vida: altura (px)"
                type: Float
                value: 44
                defaultValue: 44
              - name: lifeIconX
                displayName: "Icone de vida: x do primeiro (px)"
                type: Float
                value: 32
                defaultValue: 32
              - name: lifeIconY
                displayName: "Icone de vida: y a partir do topo (px)"
                type: Float
                value: 60
                defaultValue: 60
              - name: lifeIconGap
                displayName: "Icone de vida: espaco entre eles (px)"
                type: Float
                value: 8
                defaultValue: 8
              - name: ammoIcon
                displayName: Icone de municao da Escopeta (vazio = texto)
                type: String
                value: HUD/municao_slug.png
                defaultValue: HUD/municao_slug.png
              - name: ammoIconWidth
                displayName: "Icone de municao: largura (px)"
                type: Float
                value: 14
                defaultValue: 14
              - name: ammoIconHeight
                displayName: "Icone de municao: altura (px)"
