                displayName: "Desenho: deslocamento X (px)"
                type: Float
                value: -9
                defaultValue: -9
              - name: visualOffsetY
                displayName: "Desenho: deslocamento Y (px)"
                type: Float
                value: 4
                defaultValue: 4
              - name: moveSpeed
                displayName: Velocidade (px/s)
                type: Float
                value: 320
                defaultValue: 320
              - name: jumpSpeed
                displayName: Velocidade do pulo (px/s)
                type: Float
                value: 860
                defaultValue: 860
              - name: gravityScale
                displayName: Escala da gravidade
                type: Float
                value: 3
                defaultValue: 3
              - name: maxFallSpeed
                displayName: Queda maxima (px/s)
                type: Float
                value: 1400
                defaultValue: 1400
              - name: respawnY
                displayName: Y limite (abaixo disso morre)
                type: Float
                value: -400
                defaultValue: -400
              - name: fireCooldown
                displayName: Intervalo entre tiros (s)
                type: Float
                value: 0.15
                defaultValue: 0.15
              - name: shotgunCooldown
                displayName: "Escopeta: intervalo entre tiros (s)"
                type: Float
                value: 0.6
                defaultValue: 0.6
              - name: shotgunPellets
                displayName: "Escopeta: projeteis por tiro"
                type: Int
                value: 5
                defaultValue: 5
              - name: shotgunSpread
                displayName: "Escopeta: abertura total (graus)"
                type: Float
                value: 40
                defaultValue: 40
              - name: shotgunLifetime
                displayName: "Escopeta: tempo de vida do projetil (s)"
                type: Float
                value: 0.35
                defaultValue: 0.35
              - name: autoFire
                displayName: Tiro automatico (segurar J)
                type: Bool
                value: false
                defaultValue: false
              - name: dropTime
                displayName: Tempo atravessando (s)
                type: Float
                value: 0.35
                defaultValue: 0.35
              - name: dashSpeed
                displayName: "Dash: velocidade (px/s)"
                type: Float
                value: 1300
                defaultValue: 1300
              - name: dashTime
                displayName: "Dash: duracao do impulso (s)"
                type: Float
                value: 0.15
                defaultValue: 0.15
