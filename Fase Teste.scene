                displayName: "Dash: quanto cada copia demora para sumir (s)"
                type: Float
                value: 0.3
                defaultValue: 0.3
              - name: dashGhostAlpha
                displayName: "Dash: opacidade inicial do rastro (0-1)"
                type: Float
                value: 0.55
                defaultValue: 0.55
              - name: dashUpKeep
                displayName: "Dash: velocidade vertical mantida ao subir (0-1)"
                type: Float
                value: 0.5
                defaultValue: 0.5
