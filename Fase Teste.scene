  - type: Entity
    entity: 1005
    name: Jogador
    components:
      transform:
        position: [300, 200, 0]
        rotation: [1, 0, 0, 0]
        scale: [1, 1, 1]
        worldPosition: [300, 200, 0]
        worldRotation: [1, 0, 0, 0]
        worldScale: [1, 1, 1]
