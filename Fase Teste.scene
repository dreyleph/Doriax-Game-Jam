              - type: lua
                path: level/ParallaxBackground.lua
                className: ParallaxBackground
                enabled: true
                properties:
                  - name: tileA
                    displayName: Copia 1 do fundo (vaga par)
                    type: EntityReference
                    ptrTypeName: Sprite
                    value: 1031
                    defaultValue: 0
                  - name: tileB
