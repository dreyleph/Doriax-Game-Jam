                displayName: "Dash: espera entre dashes (s)"
                type: Float
                value: 1
                defaultValue: 1
              - name: dashCarryKeep
                displayName: "Dash: embalo horizontal mantido ao fim (0-1)"
                type: Float
                value: 0.7
                defaultValue: 0.7
              - name: dashCarryDrag
                displayName: "Dash: quanto o embalo freia no chao"
                type: Float
                value: 10
                defaultValue: 10
