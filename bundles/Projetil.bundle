type: Entity
entity: 1
name: Projetil
components:
  transform:
    position: [0, 0, 0]
    rotation: [1, 0, 0, 0]
    scale: [1, 1, 1]
    visible: true
  mesh:
    submeshes:
      - material:
          baseColorFactor: [1, 0.85, 0.25, 1]
  sprite:
    width: 24
    height: 8
    pivotPreset: center
  body2d:
    type: kinematic
    numShapes: 1
    shapes:
      - type: polygon
        density: 0
        sensor: true
        sensorEvents: true
        categoryBits: 16
        maskBits: 9
        vertices: [[-12, -4], [12, -4], [12, 4], [-12, 4]]
  script:
    scripts:
      - type: lua
        path: projectile/Projectile.lua
        className: Projectile
        enabled: true
        properties:
          - name: speed
            displayName: Velocidade (px/s)
            type: Float
            value: 950
            defaultValue: 950
          - name: lifetime
            displayName: Tempo de vida (s)
            type: Float
            value: 1
            defaultValue: 1
          - name: damage
            displayName: Dano
            type: Int
            value: 1
            defaultValue: 1
visibilityInherited: true
